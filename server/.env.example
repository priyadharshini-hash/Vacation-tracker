PORT=4000
DATABASE_URL=postgresql://vacation_admin:vacation_pw@localhost:5432/vacation_tracker
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173

# "Sign in with Slack" (optional; the button only appears when both ID and secret are set).
# Create the Slack app at https://api.slack.com/apps - see README. Never commit the real values.
# Public address of the app (used to build the Slack redirect URL; falls back to CLIENT_ORIGIN).
APP_URL=http://localhost:5173
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Slack workspace (team) ID, e.g. T0123ABCD. When set, only people in that workspace can sign in
# and new accounts are created automatically (as employees) on first sign-in.
SLACK_TEAM_ID=

SEED_ADMIN_EMAIL=admin@numrah.com
SEED_ADMIN_PASSWORD=Admin123!
